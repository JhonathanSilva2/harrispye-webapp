// tsconfig.jest.json
{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "types": ["jest", "node"],
        "composite": false,
        "noEmit": true
    },
    "include": [
        "next-env.d.ts",
        ".next/types/**/*.ts",
        "src",
        "**/*.test.ts",
        "**/*.test.tsx",
        "jest.setup.ts"
    ],
    "exclude": [".next", "node_modules"]
}
