generator client {
  provider                = "prisma-client-js"
  output                  = "generated/client-hp-base"
  previewFeatures         = ["views"]
  binaryTargets           = ["native", "debian-openssl-3.0.x"]
  interactiveTransactions = "true"
  extendedIndexes         = "true"
}

datasource dbHPBase {
  provider = "mysql"
  url      = env("DATABASE_URL_HPBASE")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model adobe {
  hash         String   @id @dbHPBase.VarChar(255)
  data         DateTime @dbHPBase.Date
  id_perfil    BigInt?
  adobe_id     String?  @dbHPBase.VarChar(50)
  adobe_status String?  @dbHPBase.VarChar(255)
  json_data    Json?
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model adobe_pdf_data {
  hash             String   @dbHPBase.VarChar(255)
  vessel           String   @dbHPBase.VarChar(255)
  job              String   @dbHPBase.VarChar(255)
  week_ending      DateTime @dbHPBase.Date
  client           String   @dbHPBase.VarChar(255)
  shift1           String   @dbHPBase.VarChar(255)
  nationality      String   @dbHPBase.VarChar(255)
  total_head_count Int      @dbHPBase.TinyInt
  name             Json
  trade            Json
  shift            Json
  mon              Json
  tue              Json
  wed              Json
  thu              Json
  fri              Json
  sat              Json
  sun              Json
  hours            Json
  rate             Json?
  total_each       Json?
  total_final      String?  @dbHPBase.VarChar(255)
  job_mon          Json
  job_tue          Json
  job_wed          Json
  job_thu          Json
  job_fri          Json
  job_sat          Json
  job_sun          Json
  my_row_id        BigInt   @id @dbHPBase.UnsignedBigInt

  @@ignore
}

model appraisal {
  id              Int      @id @default(autoincrement())
  hp_registration Int
  questions       Json?
  comments        Json?
  year            Int
  created_at      DateTime @default(now()) @dbHPBase.DateTime(0)
}

model certificates {
  id                 Int       @id @default(autoincrement())
  hp_number          Int
  certificate_number Int
  form_data          Json
  date_created       DateTime? @default(now()) @dbHPBase.Timestamp(0)
  created_by         String    @dbHPBase.VarChar(255)
}

model departments {
  id         Int    @id @default(autoincrement())
  department String @dbHPBase.VarChar(255)
  manager    Int
}

model fabrication_monitoring {
  id                               Int                                     @id @default(autoincrement())
  fabrication_monitoring_design_id Int?
  id_fabrication_monitoring_jobs   Int
  spec                             String?                                 @dbHPBase.VarChar(255)
  mass                             Decimal?                                @dbHPBase.Decimal(10, 2) @default(0.00)
  price_per_kg                     Decimal?                                @dbHPBase.Decimal(10, 2) @default(0.00)
  m2_fbe                           Decimal?                                @dbHPBase.Decimal(10, 2) @default(0.00)
  m2_galvanized                    Decimal?                                @dbHPBase.Decimal(10, 2) @default(0.00)
  m2_price                         Decimal?                                @dbHPBase.Decimal(10, 2) @default(0.00)
  gross_spool_cost                 Decimal?                                @dbHPBase.Decimal(10, 2) @default(0.00)
  description                      String?                                 @dbHPBase.VarChar(255)
  drawing_ref                      String?                                 @dbHPBase.VarChar(255)
  spool_number                     String?                                 @dbHPBase.VarChar(255)
  materials_ordered                Int? @default(0)
  materials_arrived                Int? @default(0)
  fabrication_complete             Int? @default(0)
  scan_3d                          Int? @default(0)
  ndt_complete                     Int? @default(0)
  pressure_test                    Int? @default(0)
  internal_coating                 Int? @default(0)
  external_coating                 Int? @default(0)
  packing                          Int? @default(0)
  dispatch                         Int? @default(0)
  notes                            String?                                 @dbHPBase.VarChar(255)
  client_approval                  fabrication_monitoring_client_approval  @default(PENDING)
  manager_approval                 fabrication_monitoring_manager_approval @default(PENDING)
  updated_by                       Int?
  updated_at                       DateTime?                               @dbHPBase.DateTime(0)
  drawing_sort_key                 BigInt?                                 @dbHPBase.UnsignedBigInt
  spool_sort_key                   BigInt?                                 @dbHPBase.UnsignedBigInt
  fabrication_monitoring_designs   fabrication_monitoring_designs?         @relation(fields: [fabrication_monitoring_design_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fabrication_monitoring_designs")
  fabrication_monitoring_jobs      fabrication_monitoring_jobs             @relation(fields: [id_fabrication_monitoring_jobs], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fabrication_monitoring_jobs")

  @@index([fabrication_monitoring_design_id], map: "fk_fabrication_monitoring_designs")
  @@index([id_fabrication_monitoring_jobs], map: "fk_fabrication_monitoring_jobs")
  @@index([drawing_sort_key, spool_sort_key], map: "idx_sort")
}

model fabrication_monitoring_permissions {
  user_organizations_id Int
  user_roles_id         Int
  user_localizations_id Int
  user_clearance        user_clearance                           @default(LOW)
  add_spools            Boolean                                  @default(false)
  delete_spools         Boolean                                  @default(false)
  spec                  fabrication_monitoring_permission_action @default(NONE)
  mass                  fabrication_monitoring_permission_action @default(NONE)
  m2_fbe                fabrication_monitoring_permission_action @default(NONE)
  m2_galvanized         fabrication_monitoring_permission_action @default(NONE)
  m2_price              fabrication_monitoring_permission_action @default(NONE)
  price_per_kg          fabrication_monitoring_permission_action @default(NONE)
  gross_spool_cost      fabrication_monitoring_permission_action @default(NONE)
  description           fabrication_monitoring_permission_action @default(NONE)
  drawing_ref           fabrication_monitoring_permission_action @default(NONE)
  spool_number          fabrication_monitoring_permission_action @default(NONE)
  materials_ordered     fabrication_monitoring_permission_action @default(NONE)
  materials_arrived     fabrication_monitoring_permission_action @default(NONE)
  fabrication_complete  fabrication_monitoring_permission_action @default(NONE)
  scan_3d               fabrication_monitoring_permission_action @default(NONE)
  ndt_complete          fabrication_monitoring_permission_action @default(NONE)
  pressure_test         fabrication_monitoring_permission_action @default(NONE)
  internal_coating      fabrication_monitoring_permission_action @default(NONE)
  external_coating      fabrication_monitoring_permission_action @default(NONE)
  packing               fabrication_monitoring_permission_action @default(NONE)
  dispatch              fabrication_monitoring_permission_action @default(NONE)
  notes                 fabrication_monitoring_permission_action @default(NONE)
  client_approval       fabrication_monitoring_permission_action @default(NONE)
  manager_approval      fabrication_monitoring_permission_action @default(NONE)
  graph                 Boolean                                  @default(false)
  summary               Boolean                                  @default(false)
  user_localizations    user_localizations                       @relation(fields: [user_localizations_id], references: [id], onDelete: Cascade)
  user_organizations    user_organizations                       @relation(fields: [user_organizations_id], references: [id], onDelete: Cascade)
  user_roles            user_roles                               @relation(fields: [user_roles_id], references: [id], onDelete: Cascade)

  @@id([user_organizations_id, user_roles_id, user_localizations_id, user_clearance])
  @@index([user_localizations_id], map: "fabrication_monitoring_permissions_localizations_id_fkey")
  @@index([user_roles_id], map: "fabrication_monitoring_permissions_user_roles_id_fkey")
  @@index([user_organizations_id], map: "fabrication_monitoring_permissions_user_organizations_id_fkey")
}

model fabrication_monitoring_designs {
  id                             Int                         @id @default(autoincrement())
  fabrication_monitoring_jobs_id Int
  filename                       String                      @dbHPBase.VarChar(255)
  display_name                   String                      @dbHPBase.VarChar(255)
  created_at                     DateTime                    @default(now()) @dbHPBase.DateTime(0)
  fabrication_monitoring         fabrication_monitoring[]
  fabrication_monitoring_jobs    fabrication_monitoring_jobs @relation(fields: [fabrication_monitoring_jobs_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fabrication_monitoring_jobs_id")

  @@index([fabrication_monitoring_jobs_id], map: "fk_fabrication_monitoring_jobs_id")
}

model fabrication_monitoring_jobs {
  id                             Int                              @id @default(autoincrement())
  hp                             String                           @unique @dbHPBase.VarChar(255)
  client_ref                      String?                          @dbHPBase.VarChar(255)
  client                         String                           @dbHPBase.VarChar(255)
  contract_delivery_date         DateTime                         @dbHPBase.Date
  expected_delivery_date         DateTime                         @dbHPBase.Date
  existing_design                String?                          @dbHPBase.VarChar(255)
  updated_design                 String?                          @dbHPBase.VarChar(255)
  po_number                      String                           @dbHPBase.VarChar(255)
  organization_id                Int?
  user_organizations             user_organizations?              @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fabrication_monitoring_jobs_organization_id", name: "OrgToJobs")
  fabrication_monitoring         fabrication_monitoring[]
  fabrication_monitoring_designs fabrication_monitoring_designs[]
  job_description                String?                          @dbHPBase.VarChar(255)
}

model fabrication_monitoring_log {
  id                             Int       @id @default(autoincrement())
  fabrication_monitoring_id      Int
  fabrication_monitoring_jobs_id Int
  method                         String    @dbHPBase.VarChar(255)
  previous_state                 String    @dbHPBase.Text
  new_state                      String    @dbHPBase.Text
  updated_at                     DateTime? @default(now()) @dbHPBase.DateTime(0)
  updated_by                     Int

  @@index([fabrication_monitoring_id], map: "fabrication_monitoring_id")
  @@index([fabrication_monitoring_jobs_id], map: "fabrication_monitoring_jobs_id")
}

