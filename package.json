{
    "name": "harrispye-az-next",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "prisma-init": "npx concurrently \"prisma generate --schema prisma/schema-hp-base.prisma\" \"prisma generate --schema prisma/schema-proposals.prisma\"",
        "prisma-diff": "npx prisma migrate diff --schema prisma/schema-hp-base.prisma --from-empty --to-schema-datamodel prisma/schema-hp-base.prisma --script > prisma/migrations/init/migration.sql & npx prisma migrate diff --schema prisma/schema-proposals.prisma --from-empty --to-schema-datamodel prisma/schema-proposals.prisma --script > prisma/migrations/init/migration.sql",
        "prisma-resolve": "npx prisma migrate resolve --schema prisma/schema-hp-base.prisma --applied init & npx prisma migrate resolve --schema prisma/schema-proposals.prisma --applied init",
        "prisma-pull": "npx prisma db pull --schema prisma/schema-hp-base.prisma & npx prisma db pull --schema prisma/schema-proposals.prisma",
        "prisma-push": "npx prisma db push --schema prisma/schema-hp-base.prisma & npx prisma db push --schema prisma/schema-proposals.prisma",
        "postinstall": "npm run prisma-init",
        "postbuild": "echo '=== Prisma engines in standalone folder ===' && find .next/standalone -type f -name '*.so.node'",
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "test": "jest",
        "test:watch": "jest --watch",
        "coverage": "jest --coverage",
        "prod": "next build && next start",
        "lint": "next lint"
    },
    "engines": {
        "node": "^20.9.0"
    },
    "dependencies": {
        "@azure/storage-blob": "^12.27.0",
